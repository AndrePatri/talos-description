<robot name="talos" xmlns:xacro="http://ros.org/wiki/xacro"
        xmlns:sensor="http://playerstage.sourceforge.net/gazebo/xmlschema/#sensor"
        xmlns:controller="http://playerstage.sourceforge.net/gazebo/xmlschema/#controller"
        xmlns:interface="http://playerstage.sourceforge.net/gazebo/xmlschema/#interface">

  <xacro:arg name="root" default="$(find talos_description)" />
  <xacro:property name="ROOT" value="$(arg root)" />
  <xacro:arg name="pal_urdf_utils_root" default="${ROOT}/../../pal_urdf_utils" />
  <xacro:property name="PAL_URDF_UTILS_ROOT" value="$(arg pal_urdf_utils_root)" />
  <xacro:arg name="talos_description_inertial_root" default="${ROOT}/../talos_description_inertial" />
  <xacro:property name="TALOS_DESCRIPTION_INERTIAL_ROOT" value="$(arg talos_description_inertial_root)" />
  <xacro:arg name="talos_description_calibration_root" default="${ROOT}/../talos_description_calibration" />
  <xacro:property name="TALOS_DESCRIPTION_CALIBRATION_ROOT" value="$(arg talos_description_calibration_root)" />
  <xacro:arg name="use_abs_mesh_paths" default="false"/>
  <xacro:arg name="use_local_filesys_for_meshes" default="false"/>
  <xacro:property name="USE_ABS_MESH_PATHS" value="$(arg use_abs_mesh_paths)" />
  <xacro:property name="USE_LOCAL_FILESYS_FOR_MESHES" value="$(arg use_local_filesys_for_meshes)" />

  <xacro:if value="${USE_ABS_MESH_PATHS}">
    <xacro:if value="${USE_LOCAL_FILESYS_FOR_MESHES}">
      <xacro:property name="MESH_PATH" value="file://${ROOT}/meshes" />
    </xacro:if>
    <xacro:unless value="${USE_LOCAL_FILESYS_FOR_MESHES}">
      <xacro:property name="MESH_PATH" value="${ROOT}/meshes" />
    </xacro:unless>
  </xacro:if>
  <xacro:unless value="${USE_ABS_MESH_PATHS}">
    <xacro:property name="MESH_PATH" value="package://talos_description/meshes" />
  </xacro:unless>

  <xacro:if value="$(arg enable_crane)">
    <xacro:include filename="${ROOT}/urdf/crane/crane.urdf.xacro" />
  </xacro:if>

  <xacro:include filename="${ROOT}/urdf/torso/torso.urdf.xacro" />
  <xacro:include filename="${ROOT}/urdf/head/head.urdf.xacro" />
  <xacro:include filename="${ROOT}/urdf/arm/arm_specifics_v2.urdf.xacro" />
  <xacro:include filename="${ROOT}/urdf/arm/arm.urdf.xacro" />
  <xacro:include filename="${PAL_URDF_UTILS_ROOT}/urdf/ft_sensors/ati_talos.urdf.xacro" />
  <xacro:include filename="${ROOT}/urdf/leg/leg.urdf.xacro" />
  <xacro:include filename="${ROOT}/urdf/leg/foot_collision_$(arg foot_collision).urdf.xacro" />
  <xacro:include filename="${TALOS_DESCRIPTION_INERTIAL_ROOT}/urdf/inertial.xacro" />
  <xacro:include filename="${ROOT}/urdf/extras/addons.urdf.xacro" />

  <xacro:talos_torso name="torso" />
  
  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="multiple" default="false"/>

  <xacro:property name="is_multiple" value="$(arg multiple)" />

  <xacro:if value="$(arg enable_crane)">
    <xacro:crane parent="torso_2_link"/>
  </xacro:if>

  <xacro:talos_head name="head" parent="torso_2_link" disable_gazebo_camera="$(arg disable_gazebo_camera)"/>

  <xacro:talos_arm name="arm" parent="torso_2_link" side="left" reflect="1"/>
  <xacro:talos_arm name="arm" parent="torso_2_link" side="right" reflect="-1"/>

  <xacro:ft_sensor name="wrist" parent="arm_right_7_link" side="right" reflect="1"  />
  <xacro:ft_sensor name="wrist" parent="arm_left_7_link"  side="left"  reflect="-1" />

  <xacro:talos_leg prefix="left"  reflect="1" />
  <xacro:talos_leg prefix="right" reflect="-1" />

  <!-- Macro to have the add-on links specific to each TALOS -->
  <xacro:talos_addons />

  <!-- Generic simulator_gazebo plugins -->
  <xacro:include filename="${ROOT}/gazebo/gazebo.urdf.xacro" />
  <!-- Materials for visualization -->
  <xacro:include filename="${ROOT}/urdf/materials.urdf.xacro" />
  
  <!-- this model does not consider grippers, we add them as balls -->
<xacro:macro name="foo_ee" params="suffix parent_link size mass *origin">
 <link name="foo_ee_${suffix}">
   <inertial>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <mass value="${mass}"/>
     <inertia ixx="${2.*mass*size*size/3.}"  ixy="0"  ixz="0" iyy="${2.*mass*size*size/3.}" iyz="0" izz="${2.*mass*size*size/3.}" />
   </inertial>
   <visual>
     <origin xyz="0 0 0" rpy="0 0 0" />
     <geometry>
       <sphere radius="${size}" />
     </geometry>
     <material name="Cyan">
       <color rgba="0 1.0 1.0 1.0"/>
     </material>
   </visual>
   <collision>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <geometry>
       <sphere radius="${size}" />
     </geometry>
   </collision>
 </link>

<joint name="foo_ee_${suffix}_joint" type="fixed">
    <xacro:insert_block name="origin"/>
    <parent link="${parent_link}"/>
    <child link="foo_ee_${suffix}"/>
 </joint>

</xacro:macro>

<xacro:foo_ee suffix="left" parent_link="wrist_left_ft_tool_link" size="0.05" mass="1.1">
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
</xacro:foo_ee>

<xacro:foo_ee suffix="right" parent_link="wrist_right_ft_tool_link" size="0.05" mass="1.1">
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
</xacro:foo_ee>

<!-- ROS 2 Control-->
<xacro:include filename="${ROOT}/ros2_control/ros2_control.urdf.xacro" />
<xacro:talos_ros2_control use_sim="$(arg use_sim)"/>

</robot>
